class Solution {
    public TreeNode inorderSuccessor(TreeNode root, TreeNode p) {
        TreeNode successor = null;

        while (root != null) {
            if (p.val >= root.val) {
                // Successor must be in the right subtree
                root = root.right;
            } else {
                // Current root can be a successor
                successor = root;
                root = root.left;
            }
        }

        return successor;
    }
}
